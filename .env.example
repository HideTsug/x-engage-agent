# Repo-root configuration. Copy to .env and fill in (never commit .env).
# X API credentials live separately in xmcp/.env (see xmcp/env.example).

# --- Chatwork notification (where candidates are delivered) ---
# API token: https://www.chatwork.com/service/packages/chatwork/subpackages/integrations/api.php
CHATWORK_API_TOKEN=
# Room id = the number after "rid" in the room URL (.../#!rid123456789)
CHATWORK_ROOM_ID=

# --- Target account ---
# The X handle whose following/followers are tracked (no leading @).
X_USERNAME=your_x_handle

# --- Optional overrides ---
# Days a non-mutual follow ages before becoming an unfollow candidate.
# UNFOLLOW_AGE_DAYS=7
# Claude model used by engage.sh for the engager session.
# CLAUDE_MODEL_ENGAGER=sonnet
